# Public — safe to expose to the browser (NEXT_PUBLIC_ prefix required by
# Next.js for that; anything without the prefix stays server-only).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# The chat Socket.IO gateway lives on the same backend server, just without
# the /api prefix (Socket.IO owns its own /socket.io transport path plus a
# /chat namespace) — this is the origin only, no path.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Stripe PUBLISHABLE key only — never the secret key. This is intentionally
# the only Stripe-related var here; STRIPE_SECRET_KEY lives exclusively in
# the backend's .env and must never appear in this file.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
